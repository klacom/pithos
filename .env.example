# Copy this file to `.env.local` and fill in your own values.
# Never commit real keys (`.env` and `.env*.local` are git-ignored).

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key: server only, used for admin Storage uploads
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo (use test-mode keys for local development)
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
NEXT_PUBLIC_PAYMONGO_WEBHOOK_SECRET=

# Cloudflare Turnstile CAPTCHA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AES-256 key for encrypting sensitive fields: must be exactly 32 characters
ENCRYPTION_KEY=

# Gmail app password for order-confirmation emails
GMAIL_APP_PASSWORD=
